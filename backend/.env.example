PORT=5000
DATABASE_URL=postgresql://labvault_app:replace-with-a-strong-password@127.0.0.1:5432/labvault
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:5173

# Optional: provision/promote the initial administrator at startup.
# Use a dedicated account and a password of at least 12 characters.
# Uncomment and replace these values to provision the initial administrator.
# ADMIN_EMAIL=admin@example.edu
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# ADMIN_NAME=LabVault Administrator
